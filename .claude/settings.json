{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(*.env)",
			"Read(*/.env.*)",
			"Bash(git push origin dev:*)",
			"Bash(git push origin main:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(rm:*)",
			"Bash(curl:*)"
		],
		"defaultMode": "default"
	},
	"env": {
		"NODE_ENV": "development",
		"CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ai/stale-cards.sh --quiet-if-none" }]
			}
		]
	}
}
