{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(*.env)",
			"Read(*/.env.*)",
			"Bash(git push origin dev:*)",
			"Bash(git push origin main:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(rm:*)",
			"Bash(curl:*)"
		],
		"defaultMode": "default"
	},
	"env": {
		"NODE_ENV": "development"
	}
}
