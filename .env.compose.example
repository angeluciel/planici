# Local `docker compose` stack config (JOA-39) — copy to `.env.compose`
# (gitignored) and adjust if needed. `compose.yaml` itself has no secrets;
# every service reads its env from this file via `env_file`.
#
# `db` is a throwaway postgres:17 container with no named volume — `docker
# compose down` discards all data, so these are local-only, low-stakes
# values, not real secrets.

# --- db / owner (migration) role ---
# Provisions the postgres container itself (read by the official postgres
# image's entrypoint) and is also the role `migrate` runs drizzle-kit
# migrations + apps/api/src/database/bootstrap/app-role.sql as (owner:
# superuser locally, NOT the role the api connects with — see DATABASE_URL_APP
# below). `db` is the compose service name/hostname on the internal network.
POSTGRES_DB=planici
POSTGRES_USER=planici
POSTGRES_PASSWORD=planici
DATABASE_URL=postgres://planici:planici@db:5432/planici

# --- app role (RLS-constrained runtime role) ---
# APP_ROLE / APP_PASSWORD are passed to app-role.sql as psql -v variables by
# `migrate` (NOSUPERUSER NOBYPASSRLS, DML-only grants). DATABASE_URL_APP is
# what `api` (and `smoke`) actually connect with.
APP_ROLE=planici_app
APP_PASSWORD=planici_app
DATABASE_URL_APP=postgres://planici_app:planici_app@db:5432/planici

# --- api ---
NODE_ENV=production
PORT=3030
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
JWT_SECRET=change-me-min-16-characters
JWT_REFRESH_SECRET=change-me-min-16-characters-too
OBSERVE_APP_KEY=local-dev-observe-key
OBSERVE_APP_SECRET=local-dev-observe-secret
