{
	"name": "planici",
	"version": "1.0.0",
	"description": "TO-DO",
	"private": true,
	"scripts": {
		"clean": "turbo run clean",
		"dev": "pnpm db:up && pnpm db:migrate && turbo run dev --filter=api --filter=web",
		"dev:api": "turbo run dev --filter=api",
		"db:up": "docker compose -f compose.dev.yaml up -d --wait",
		"db:down": "docker compose -f compose.dev.yaml down",
		"db:migrate": "DATABASE_URL=postgresql://planici:planici@127.0.0.1:5433/planici_dev pnpm --filter api exec drizzle-kit migrate",
		"dev:web": "turbo run dev --filter=web",
		"dev:email": "turbo run dev --filter=@planici/emails",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck",
		"prepare": "husky"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx,json,css}": [
			"biome check --write"
		]
	},
	"author": "João Pedro Medeiros Izidoro",
	"engines": {
		"node": ">=24.16.0 <27"
	},
	"packageManager": "pnpm@12.3.4",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.3.4",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@sonar/scan": "^5.0.0",
		"@types/node": "^20.19.41",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"rimraf": "^6.1.3",
		"turbo": "^2.10.7"
	}
}
