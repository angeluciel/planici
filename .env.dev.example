# Local dev DB (JOA-39 answers.md #11) — the `dev` compose profile
# (`db-dev` + `migrate-dev` in `compose.yaml`).
#
# Unlike `.env.compose.example` (consumed via `env_file:` inside the `db`/
# `migrate`/`api`/`smoke` containers), these are top-level `${VAR:-default}`
# Compose FILE interpolation — resolved from your shell env or a root
# `.env` (gitignored, not read by any agent), never from `.env.compose`.
# All defaults below already work with no file at all; only set these if you
# want different local values. Never commit a real `.env`/`.env.dev`.

# postgres:17 container itself, published on localhost:5432.
PLANICI_DEV_DB_NAME=planici
PLANICI_DEV_DB_USER=planici
PLANICI_DEV_DB_PASSWORD=planici

# Passed to app-role.sql by `migrate-dev` so local dev also runs as the
# RLS-constrained `planici_app` role (never as the Postgres owner), same as
# prod. After `docker compose --profile dev up -d db-dev migrate-dev`,
# point apps/api/.env (your own edit, not an agent's) at:
#   DATABASE_URL_APP=postgres://planici_app:<PLANICI_DEV_APP_PASSWORD>@localhost:5432/planici
PLANICI_DEV_APP_ROLE=planici_app
PLANICI_DEV_APP_PASSWORD=planici_app_dev
