{
	"compilerOptions": {
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"rootDir": ".",
		"outDir": "./dist",
		"declaration": true,
		"noEmit": false,
		"noEmitOnError": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["index.ts"],
	"exclude": ["dist", "node_modules"]
}
