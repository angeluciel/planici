{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",

		"rootDir": "./src",
		"outDir": "./dist",

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,

		"resolveJsonModule": true,

		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"]
}
